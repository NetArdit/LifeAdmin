# Dependencies
node_modules/

# Local SQLite database (contains real user data — never commit it)
data/*.db
data/*.db-*

# Environment variables / secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Misc
*.tmp

# Netlify local state
.netlify/

# The local PostgreSQL (PGlite) database of development
data/pg/

# Copies of the database (npm run db:backup): people's data in the clear, never in the repository
backups/

# The PDF library, copied from its package by the web build (npm run build:web)
public/vendor/
.scratch/
