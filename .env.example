# Copy this file to .env and fill in values.

# Optional. Enables the AI assistant, natural-language planning, DecisionFlow
# analysis, BillSense/EcoLife insights, and the weekly review. Without it,
# the app runs fully — those features show "AI unavailable" instead.
ANTHROPIC_API_KEY=

# Optional. Overrides the Claude model used for all AI features. Defaults to
# claude-opus-5 if unset — only set this if you need to pin a different model.
ANTHROPIC_MODEL=

# Port the server listens on. 3001 by default to avoid clashing with other
# local dev servers commonly running on 3000.
PORT=3001

# Set to "production" when deployed behind HTTPS: the session cookie is then
# marked Secure (only sent over HTTPS). Leave as development for local use.
NODE_ENV=development


# ---------------------------------------------------------------------------
# Password recovery email (Resend) — READ BEFORE DEPLOYING.
# Server-side only. Never put these values in frontend code, Git, or a
# committed .env file; set them in your host's secret/environment settings.
#
# Delivery works only when ALL of the following are true:
#   1. You have a Resend account and a sending domain you control, verified in
#      Resend (SPF/DKIM DNS records published). LifeAdmin does not ship a
#      default sender: an address on an unverified domain will be rejected.
#   2. RESEND_API_KEY is set to an API key from that account.
#   3. MAIL_FROM is an address on that verified domain.
#   4. APP_BASE_URL is the real public https:// origin of this app.
#   5. NODE_ENV=production (or MAIL_TRANSPORT=resend).
# If any of these is missing in production, no email is sent; the forgot-
# password request still returns the same generic response and no usable
# reset token is left behind. A real-inbox test is required before relying
# on it.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Sender, e.g.  LifeAdmin <no-reply@your-verified-domain.example>
MAIL_FROM=

# Optional. Mail transport override: outbox | none | resend.
# Default: "outbox" outside production (in-memory; dev prints the reset link to
# the server console); in production "resend" when RESEND_API_KEY and MAIL_FROM
# are both set, otherwise "none" (sends nothing).
MAIL_TRANSPORT=

# Optional. Provider request timeout in milliseconds (default 10000).
MAIL_TIMEOUT_MS=

# Public origin used to build reset links, e.g. https://app.example.com
# (no path). Required in production and must be https://. The request's Host
# header is never used. In development it defaults to http://localhost:PORT.
APP_BASE_URL=

# Test-only: RESEND_API_BASE points the adapter at a local mock server. It is
# IGNORED when NODE_ENV=production so the API key can never be redirected.
# Leave unset.
# RESEND_API_BASE=

# Reading a picture of a document (Documents -> Scan) needs a model that takes pictures. With Groq the default
# is the one its documentation named when this was written; set this if Groq has replaced it since.
GROQ_VISION_MODEL=
# Room for pictures of documents, which are kept in the database: megabytes per person and for everybody.
# Defaults: 20 and 200.
DOCUMENTS_MAX_MB_PER_USER=
DOCUMENTS_MAX_MB_TOTAL=

# Notifications on phones and in browsers (Web Push). Make a pair once with:  npm run push:keys
# The private key is a secret: only in the host's environment settings, never in the code. Changing the pair
# disconnects every device that had turned notifications on.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, "mailto:you@example.com" or the site's https address.
VAPID_SUBJECT=
# Keeps the stored addresses of devices unreadable in the database. 32 characters or more, random, made by the
# same command. Keep a copy somewhere safe and never change it together with the pair above. There is no
# re-encryption step yet: if it is replaced, every device has to turn notifications on again.
PUSH_STORE_KEY=

# Requests that change something are accepted only from the site's own address: APP_BASE_URL, and these
# further addresses if the site has more than one (comma separated, e.g. https://www.example.com).
ALLOWED_ORIGINS=

# Limits on tries (sign-in, password reset, codes, invite codes) are counted in the database, so every running
# copy of the application shares one count. Whom a count is about is stored as a keyed hash; this is the key.
# Set a random value of its own in production. Without it PUSH_STORE_KEY is used, then DATABASE_URL.
# Changing it only forgets the counts of the current windows.
RATE_LIMIT_SECRET=
# The limits per address rely on the address the application sees. Behind a reverse proxy that is the proxy's
# address unless Express "trust proxy" is set for that exact topology; it is not set here.
