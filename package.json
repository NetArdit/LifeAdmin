{
  "name": "lifeadmin",
  "version": "1.0.0",
  "description": "LifeAdmin - a personal and family life-management platform",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/db/seed-demo.js",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "build:web": "npm --prefix web install --include=dev && npm --prefix web run build",
    "postinstall": "npm run build:web",
    "push:keys": "node scripts/push-keys.cjs",
    "db:backup": "node scripts/backup.cjs backup",
    "db:restore": "node scripts/backup.cjs restore",
    "db:migrate": "node -e \"const db=require('./src/db');db.ready().then(()=>db.close()).then(()=>console.log('schema applied'))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0"
  }
}
