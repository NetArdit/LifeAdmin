    "build:web": "npm --prefix web install && npm --prefix web run build",
    "postinstall": "npm run build:web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@electric-sql/pglite": "^0.5.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "serverless-http": "^3.2.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0"
  }
}
