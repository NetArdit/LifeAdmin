{
  "name": "lifeadmin",
  "version": "1.0.0",
  "description": "LifeAdmin - a personal and family life-management platform",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/db/seed-demo.js",
    "test": "node --test",
